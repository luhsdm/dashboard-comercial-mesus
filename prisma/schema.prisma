generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  AGENCY
  CLIENT
}

enum LeadStatus {
  LEAD_NOVO
  AGENDADO
  COMPARECEU
  VENDA_FECHADA
  PERDIDA
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model Tenant {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  plan      String          @default("standard")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  clients   Client[]
  settings  TenantSettings?
  purchases Purchase[]
}

model TenantSettings {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl      String?
  primaryColor String  @default("#4f8ef7")
  companyName  String?
  domain       String?
  locale       String  @default("pt-BR")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Client {
  id               String             @id @default(cuid())
  name             String
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads            Lead[]
  metaAdAccount    MetaAdAccount?
  instagramAccount InstagramAccount?
  sheetSid         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId])
}

model Lead {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime
  name        String
  phone       String?
  status      LeadStatus @default(LEAD_NOVO)
  campaign    String?
  adSet       String?
  ad          String?
  creative    String?
  sourceId    String?
  platform    String?
  revenueCard Decimal    @default(0) @db.Decimal(12, 2)
  revenueCash Decimal    @default(0) @db.Decimal(12, 2)
  month       Int
  year        Int
  createdAt   DateTime   @default(now())

  @@index([clientId])
  @@index([clientId, year, month])
  @@index([clientId, status])
}

model MetaAdAccount {
  id          String             @id @default(cuid())
  clientId    String             @unique
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountId   String
  accessToken String
  tokenExpiry DateTime
  lastSyncAt  DateTime?
  status      String             @default("active")
  insights    CampaignInsight[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model CampaignInsight {
  id             String        @id @default(cuid())
  metaAccountId  String
  metaAccount    MetaAdAccount @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  date           DateTime
  campaignId     String
  campaignName   String
  adSetId        String?
  adSetName      String?
  adId           String?
  adName         String?
  impressions    Int           @default(0)
  clicks         Int           @default(0)
  spend          Decimal       @default(0) @db.Decimal(12, 2)
  leads          Int           @default(0)
  reach          Int           @default(0)
  createdAt      DateTime      @default(now())

  @@index([metaAccountId, date])
  @@unique([metaAccountId, date, campaignId, adSetId, adId])
}

model InstagramAccount {
  id          String          @id @default(cuid())
  clientId    String          @unique
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  igUserId    String
  username    String
  pageId      String
  accessToken String
  posts       ScheduledPost[]
  insights    PostInsight[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ScheduledPost {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  caption     String
  mediaUrls   String[]
  mediaType   MediaType        @default(IMAGE)
  scheduledAt DateTime
  publishedAt DateTime?
  status      PostStatus       @default(DRAFT)
  igMediaId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([accountId, status])
  @@index([scheduledAt, status])
}

model PostInsight {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igMediaId   String
  impressions Int              @default(0)
  reach       Int              @default(0)
  likes       Int              @default(0)
  comments    Int              @default(0)
  saves       Int              @default(0)
  shares      Int              @default(0)
  engagement  Float            @default(0)
  fetchedAt   DateTime         @default(now())

  @@index([accountId])
}

model Purchase {
  id         String   @id @default(cuid())
  email      String
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("BRL")
  status     String   @default("pending")
  provider   String   @default("stripe")
  externalId String?
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([externalId])
}
