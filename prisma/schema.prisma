generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum Role {
  SUPERADMIN
  AGENCY
  CLIENT
}

enum LeadStatus {
  LEAD_NOVO
  AGENDADO
  COMPARECEU
  VENDA_FECHADA
  PERDIDA
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationStatus {
  OPEN
  QUALIFIED
  DISQUALIFIED
  CLOSED
}

enum AgentType {
  PRE_QUALIFICATION
  KANBAN_MOVER
  INSTAGRAM
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL
  REELS
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

// ──────────────────────────────────────────
// Core: Tenant, User, Client
// ──────────────────────────────────────────

model Tenant {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  plan             String             @default("standard")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  clients          Client[]
  settings         TenantSettings?
  purchases        Purchase[]
  whatsappAccounts WhatsAppAccount[]
  agentConfigs     AgentConfig[]
  pipelineStages   PipelineStage[]
  trackingEvents   TrackingEvent[]
  consentRecords   ConsentRecord[]
}

model TenantSettings {
  id               String  @id @default(cuid())
  tenantId         String  @unique
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl          String?
  primaryColor     String  @default("#4f8ef7")
  companyName      String?
  domain           String?
  locale           String  @default("pt-BR")
  whatsappEnabled  Boolean @default(false)
  aiAgentsEnabled  Boolean @default(false)
  instagramEnabled Boolean @default(false)
  defaultLlmProvider String?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Client {
  id               String             @id @default(cuid())
  name             String
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads            Lead[]
  metaAdAccount    MetaAdAccount?
  googleAdAccount  GoogleAdAccount?
  instagramAccount InstagramAccount?
  sheetSid         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId])
}

// ──────────────────────────────────────────
// CRM: Lead, Pipeline
// ──────────────────────────────────────────

model Lead {
  id                 String           @id @default(cuid())
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date               DateTime
  name               String
  phone              String?
  email              String?
  status             LeadStatus       @default(LEAD_NOVO)
  pipelineStageId    String?
  pipelineStage      PipelineStage?   @relation(fields: [pipelineStageId], references: [id])
  qualificationScore Int?
  campaign           String?
  adSet              String?
  ad                 String?
  creative           String?
  sourceId           String?
  platform           String?
  revenueCard        Decimal          @default(0) @db.Decimal(12, 2)
  revenueCash        Decimal          @default(0) @db.Decimal(12, 2)
  month              Int
  year               Int
  conversations      Conversation[]
  trackingEvents     TrackingEvent[]
  consentRecords     ConsentRecord[]
  createdAt          DateTime         @default(now())

  @@index([clientId])
  @@index([clientId, year, month])
  @@index([clientId, status])
  @@index([phone])
}

model PipelineStage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  order     Int
  color     String   @default("#4f8ef7")
  isDefault Boolean  @default(false)
  isFinal   Boolean  @default(false)
  leads     Lead[]
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@unique([tenantId, slug])
}

// ──────────────────────────────────────────
// WhatsApp (Meta Cloud API)
// ──────────────────────────────────────────

model WhatsAppAccount {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumberId String         @unique
  displayPhone  String
  wabaId        String
  accessToken   String
  webhookSecret String?
  status        String         @default("active")
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
}

model Conversation {
  id                 String             @id @default(cuid())
  whatsappAccountId  String
  whatsappAccount    WhatsAppAccount    @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               Lead?              @relation(fields: [leadId], references: [id])
  contactPhone       String
  contactName        String?
  status             ConversationStatus @default(OPEN)
  qualificationScore Int?
  lastMessageAt      DateTime?
  messages           Message[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([whatsappAccountId, contactPhone])
  @@index([leadId])
  @@unique([whatsappAccountId, contactPhone])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String?          @unique
  direction      MessageDirection
  content        String
  mediaUrl       String?
  mediaType      String?
  status         String           @default("sent")
  agentGenerated Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// ──────────────────────────────────────────
// AI Agents
// ──────────────────────────────────────────

model AgentConfig {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  type             AgentType
  llmProvider      String          @default("openai")
  llmModel         String          @default("gpt-4o-mini")
  llmApiKey        String?
  systemPrompt     String          @db.Text
  temperature      Float           @default(0.7)
  maxTokens        Int             @default(1024)
  active           Boolean         @default(true)
  promptTemplateId String?
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, type])
  @@unique([tenantId, type])
}

model PromptTemplate {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  industry    String?
  agentType   AgentType
  content     String        @db.Text
  version     Int           @default(1)
  isBuiltIn   Boolean       @default(false)
  agents      AgentConfig[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ──────────────────────────────────────────
// Meta Ads
// ──────────────────────────────────────────

model MetaAdAccount {
  id          String            @id @default(cuid())
  clientId    String            @unique
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountId   String
  accessToken String
  tokenExpiry DateTime
  lastSyncAt  DateTime?
  status      String            @default("active")
  insights    CampaignInsight[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CampaignInsight {
  id            String        @id @default(cuid())
  metaAccountId String
  metaAccount   MetaAdAccount @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  date          DateTime
  campaignId    String
  campaignName  String
  adSetId       String?
  adSetName     String?
  adId          String?
  adName        String?
  impressions   Int           @default(0)
  clicks        Int           @default(0)
  spend         Decimal       @default(0) @db.Decimal(12, 2)
  leads         Int           @default(0)
  reach         Int           @default(0)
  createdAt     DateTime      @default(now())

  @@index([metaAccountId, date])
  @@unique([metaAccountId, date, campaignId, adSetId, adId])
}

// ──────────────────────────────────────────
// Google Ads
// ──────────────────────────────────────────

model GoogleAdAccount {
  id           String            @id @default(cuid())
  clientId     String            @unique
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customerId   String
  refreshToken String
  lastSyncAt   DateTime?
  status       String            @default("active")
  insights     GoogleAdInsight[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model GoogleAdInsight {
  id                String          @id @default(cuid())
  accountId         String
  account           GoogleAdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date              DateTime
  campaignId        String
  campaignName      String
  adGroupId         String?
  adGroupName       String?
  impressions       Int             @default(0)
  clicks            Int             @default(0)
  spend             Decimal         @default(0) @db.Decimal(12, 2)
  conversions       Int             @default(0)
  costPerConversion Decimal?        @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())

  @@index([accountId, date])
  @@unique([accountId, date, campaignId, adGroupId])
}

// ──────────────────────────────────────────
// Instagram Agent
// ──────────────────────────────────────────

model InstagramAccount {
  id          String          @id @default(cuid())
  clientId    String          @unique
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  igUserId    String
  username    String
  pageId      String
  accessToken String
  posts       ScheduledPost[]
  insights    PostInsight[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ScheduledPost {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  caption     String
  mediaUrls   String[]
  mediaType   MediaType        @default(IMAGE)
  scheduledAt DateTime
  publishedAt DateTime?
  status      PostStatus       @default(DRAFT)
  igMediaId   String?
  aiGenerated Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([accountId, status])
  @@index([scheduledAt, status])
}

model PostInsight {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igMediaId   String
  impressions Int              @default(0)
  reach       Int              @default(0)
  likes       Int              @default(0)
  comments    Int              @default(0)
  saves       Int              @default(0)
  shares      Int              @default(0)
  engagement  Float            @default(0)
  fetchedAt   DateTime         @default(now())

  @@index([accountId])
}

// ──────────────────────────────────────────
// Tracking & Attribution
// ──────────────────────────────────────────

model TrackingEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  channel     String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  referrer    String?
  landingPage String?
  eventType   String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, channel])
  @@index([leadId])
}

// ──────────────────────────────────────────
// LGPD Compliance
// ──────────────────────────────────────────

model ConsentRecord {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  phone       String?
  consentType String
  granted     Boolean
  ipAddress   String?
  source      String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([tenantId, phone])
  @@index([leadId])
}

// ──────────────────────────────────────────
// Payments
// ──────────────────────────────────────────

model Purchase {
  id         String   @id @default(cuid())
  email      String
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("BRL")
  status     String   @default("pending")
  provider   String   @default("stripe")
  planType   String   @default("one_time")
  externalId String?
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([externalId])
}
